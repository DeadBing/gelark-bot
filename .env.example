# GeeLark OpenAPI token from the client settings page.
# Token mode is enough; leave APP_ID / API_KEY empty.
GEELARK_TOKEN=
GEELARK_APP_ID=
GEELARK_API_KEY=
GEELARK_BASE_URL=https://openapi.geelark.com

# Floppydata Client API key from https://app.floppydata.com/api-keys
FLOPPYDATA_API_KEY=
FLOPPYDATA_BASE_URL=https://api.floppydata.net

# rotating = create sticky sessions from GB/mobile balance (default)
# static = only already-purchased dedicated IPs
PROXY_MODE=rotating
PROXY_TYPE=mobile
PROXY_COUNTRY=US
PROXY_PROTOCOL=socks5
# -1 every request, 0 sticky, 5/10/15/20/60 minutes
PROXY_ROTATION=0

# GeeLark profile defaults
GEELARK_MOBILE_TYPE=Android 12
GEELARK_REGION=sgp
GEELARK_CHARGE_MODE=0
GEELARK_GROUP=
GEELARK_LANGUAGE=baseOnIP
